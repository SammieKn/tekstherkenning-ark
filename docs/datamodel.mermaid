classDiagram
%% Optional indicated by '?' ; collections shown as list~T~

class AansluitingStatus {
  <<enumeration>>
  GOED
  NIET_MEETBAAR
  SLECHT
}

class Materiaal {
  <<enumeration>>
  HOUT
  BETON
  STAAL
}

class BovenbouwMateriaal {
  <<enumeration>>
  MESTELWERK
  BASALT
  BETON_MESTELWERK
  BETON_BASALT
  BETON
}

class SchoorStand {
  <<enumeration>>
  POSITIEF
  NEGATIEF
  NEUTRAAL
}

class NietBeschikbaar {
  <<enumeration>>
  NIET_VAN_TOEPASSING
  NIET_MEETBAAR
}

class Gebrek {
  codering: str
  omschrijving: str
  figuurnummer: str
}

class Scheur {
  lengte_cm: int
  scheurwijdte_mm: int
  afstand_van_startrak: int?
  orientatie: str?
}

class GrondVoerendGat {
  afmetingen_cm: list~int?~
}

class BuikInWand {
  uitbuiking_cm: int
}

class Scheefstand {
  hoek_graden: int
}

class LokaalVerdwenenMetselwerk {
  afmetingen_cm: list~int?~
}

class Houtmonster {
  codering: str
  houtmonster_code: str
  diameter_paal_ter_hoogte_houtmonster_mm: int?
  hoogte_onder_nap_cm: int?
  hoogte_tov_onderzijde_fundering_cm: int?
  is_wankant_aanwezig: bool?
  datum_monstername: str?
  is_aangetast: bool?
  stichtingjaar: int?
}

class Metselwerk {
  gebreken: list~Gebrek~
  dikte_cm: float?
  hoogte_cm: float?
  opmerkingen: str?
}

class Bovenbouw {
  metselwerk: Metselwerk
  is_buik_in_wand_aanwezig: bool?
  is_grondvoerend_gat_aanwezig: bool?
  is_lokaal_verdwenen_metselwerk: bool?
  materiaal: BovenbouwMateriaal?
  maximaal_aantal_scheuren_per_10_m: int?
  maximale_scheurwijdte_mm: float?
  opmerkingen: str?
  percentage_niet_functionerend_schuifhout: float?
  is_scheefstand_aanwezig: bool?
  bovenkant_deksteen_cm_tov_nap: int?
}

class Kesp {
  kesp_nummer: str
  hoogte_cm: int
  breedte_cm: int
  hoek_tov_lengte_as_graden: int?
  lengte_uitstekend_deel_cm: int?
  mate_inknijping_cm: int?
  indrukking_paal_in_kesp_cm: int?
  is_opsluitklos_aanwezig: bool?
  is_opsluitklos_aangetast: bool?
  is_vervormd: bool?
  is_aangetast: bool?
  opmerkingen: str?
  paalrij_nr: str?
  gebreken: list~Gebrek~
}

class Onderloopsheidscherm {
  is_aanwezig: bool
  gebreken: list~Gebrek~
  is_beschadigd: bool?
  is_meerdere_locaties: bool?
  opmerkingen: str
}

class Paal {
  gebreken: list~Gebrek~
  paalrij_nummer: str
  paal_nummer: str
  aansluiting_status: AansluitingStatus
  is_onderzocht: bool?
  opmerkingen: str
  schoorstand_graden: float?
  scheefstand: bool?
  materiaal: Materiaal?
  diameter_haaks: int | NietBeschikbaar
  diameter_parallel: int | NietBeschikbaar
  diameter_gemiddeld: int | NietBeschikbaar
  afstand_hoh: int | NietBeschikbaar
  schoor_graden: int | NietBeschikbaar
  schoor_richting: SchoorStand | NietBeschikbaar
  afstand_frontwand_cm: int | NietBeschikbaar
  is_scheefstand: bool | NietBeschikbaar
  is_paalbreuk: bool | NietBeschikbaar
  is_aantasting: bool | NietBeschikbaar
  is_juiste_aansluiting: bool | NietBeschikbaar
  positionering_aansluiting_cm: int | NietBeschikbaar
  houtmonsters: list~Houtmonster~
}

class Vloer {
  is_beschadigd: bool
  gebreken: list~Gebrek~
  materiaal: str
  bovenkant_vloer_cm_tov_nap: float?
  is_meerdere_locaties: bool?
  opmerkingen: str?
}

class Onderbouw {
  kespen: list~Kesp~
  onderloopsheidscherm: Onderloopsheidscherm
  palen: list~Paal~
  vloer: Vloer
  materiaal: Materiaal?
}

class Rakdeel {
  bovenbouw: Bovenbouw
  constructietype: str
  gebreken: list~Gebrek~
  lengte_m: float
  onderbouw: Onderbouw
  rakdeel_id: str
  bouwjaar: int?
  opmerkingen: str?
}

class Rak {
  rakdelen: list~Rakdeel~
  raknaam: str
  totale_lengte_m: float
  opmerkingen: str?
}

%% Inheritance relationships
Scheur --|> Gebrek
GrondVoerendGat --|> Gebrek
BuikInWand --|> Gebrek
Scheefstand --|> Gebrek
LokaalVerdwenenMetselwerk --|> Gebrek

%% Composition relationships
Metselwerk *-- "0..*" Gebrek : gebreken
Bovenbouw *-- Metselwerk : metselwerk
Kesp *-- "0..*" Gebrek : gebreken
Onderloopsheidscherm *-- "0..*" Gebrek : gebreken
Paal *-- "0..*" Gebrek : gebreken
Paal --> AansluitingStatus : aansluiting_status
Paal --> Materiaal : materiaal
Paal --> SchoorStand : schoor_richting
Paal *-- "0..*" Houtmonster : houtmonsters
Vloer *-- "0..*" Gebrek : gebreken
Vloer *-- "0..*" Gebrek : gebreken
Onderbouw *-- "0..*" Kesp : kespen
Onderbouw *-- Onderloopsheidscherm : onderloopsheidscherm
Onderbouw *-- "1..*" Paal : palen
Onderbouw *-- Vloer : vloer
Onderbouw --> Materiaal : materiaal
Bovenbouw --> BovenbouwMateriaal : materiaal
Rakdeel *-- Bovenbouw : bovenbouw
Rakdeel *-- Onderbouw : onderbouw
Rakdeel *-- "0..*" Gebrek : gebreken
Rak *-- "1..*" Rakdeel : rakdelen